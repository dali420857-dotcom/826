{
  "name": "device-cloud-control-web-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "acquire:public-static": "node scripts/Acquire-PublicStatic.mjs",
    "capture:public-runtime": "node scripts/Capture-PublicRuntime.mjs",
    "build:offline": "node scripts/Build-OfflinePublicSnapshot.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check package.json index.html tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js scripts/*.mjs src tests e2e",
    "audit": "npm audit --omit=dev",
    "toolchain:check": "node scripts/check-web-toolchain.mjs"
  },
  "dependencies": {
    "axios": "1.19.0",
    "element-plus": "2.14.4",
    "firecrawl": "4.32.2",
    "msw": "2.15.0",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
