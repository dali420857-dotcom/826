{
  "schemaVersion": 1,
  "scope": "local-synthetic-no-send",
  "activationDefault": "off",
  "modules": ["data", "email", "telegram"],
  "domainOperations": {
    "data": [
      "data.previewImport",
      "data.importBatch",
      "data.listWorkItems",
      "data.updateWorkItem",
      "data.readAudit"
    ],
    "email": [
      "email.previewImport",
      "email.createDraft",
      "email.reviseDraft",
      "email.approveDraft",
      "email.enqueueLocal",
      "email.reconcile"
    ],
    "telegram": [
      "telegram.previewImport",
      "telegram.createMessage",
      "telegram.reviseMessage",
      "telegram.approveMessage",
      "telegram.enqueueLocal",
      "telegram.reconcile"
    ]
  },
  "controlSeams": ["readSnapshot", "pause", "resume"],
  "guarantees": {
    "loopbackOnly": true,
    "outboundNetworkBlocked": true,
    "syntheticMaskedData": true,
    "fakeAdaptersOnly": true,
    "providerAccess": false,
    "liveSend": false
  },
  "blocked": [
    "real-email-account",
    "real-telegram-account",
    "oauth",
    "token-read",
    "provider-adapter",
    "production-schedule",
    "live-send"
  ]
}
